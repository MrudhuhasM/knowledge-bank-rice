// Optional waybar module. Paste this block into your waybar config
// (inside the top-level object), then add "custom/kb" to modules-left/center/right.
"custom/kb": {
  "exec": "~/.local/bin/kb-stats",
  "return-type": "json",
  "interval": 60,
  "on-click": "~/.local/bin/kb-daily",
  "on-click-right": "~/.local/bin/kb-review",
  "tooltip": true
}
