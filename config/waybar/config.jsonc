// Paper & ink floating-island bar, with the RL build time log
{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 8,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/rl", "pulseaudio", "backlight", "network", "battery", "tray", "custom/power"],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "LOG",
      "2": "READ",
      "3": "WEB",
      "4": "TERM",
      "5": "MISC",
      "default": "{name}"
    },
    "persistent-workspaces": { "*": 5 }
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 42,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b  ·  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#575279'><b>{}</b></span>",
        "weekdays": "<span color='#b4637a'><b>{}</b></span>",
        "today": "<span color='#b0700f'><b><u>{}</u></b></span>"
      }
    }
  },

  "custom/rl": {
    "exec": "~/.local/bin/rl-status --waybar",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.local/bin/rl-open"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol",
    "scroll-step": 5
  },

  "backlight": {
    "format": "󰃠  {percent}%",
    "scroll-step": 5
  },

  "network": {
    "format-wifi": "󰖩  {essid}",
    "format-ethernet": "󰈀  wired",
    "format-disconnected": "󰖪  offline",
    "tooltip-format": "{ifname}  {ipaddr}",
    "max-length": 20,
    "on-click": "nm-connection-editor"
  },

  "battery": {
    "states": { "warning": 25, "critical": 12 },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },

  "tray": { "spacing": 8, "icon-size": 16 },

  "custom/power": {
    "format": "",
    "tooltip-format": "Power menu",
    "on-click": "~/.local/bin/kb-power"
  }
}
