# Knowledge Bank: notifications (paper & ink)
font=IBM Plex Sans 11
background-color=#fffaf3
text-color=#575279
border-color=#d7827e
progress-color=over #f2e9e1
border-size=2
border-radius=14
padding=14,18
margin=14
width=380
icons=1
max-icon-size=40
anchor=top-right
default-timeout=5000
layer=overlay

[urgency=low]
border-color=#dfdad9

[urgency=critical]
border-color=#b4637a
default-timeout=0

[mode=do-not-disturb]
invisible=1
