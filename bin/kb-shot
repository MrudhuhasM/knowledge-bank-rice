#!/usr/bin/env bash
# kb-shot - screenshot an area straight into the vault's Attachments folder
# and copy an Obsidian embed (![[file.png]]) to paste into a note.
# shellcheck source=kb-common
source "$(dirname "$(readlink -f "$0")")/kb-common"

mkdir -p "$VAULT/Attachments"
name="shot-$(date +%Y%m%d-%H%M%S).png"
area=$(slurp) || exit 0
grim -g "$area" "$VAULT/Attachments/$name" || kb_die "Screenshot failed"
printf '![[%s]]' "$name" | wl-copy
kb_notify "Screenshot saved to vault" "Paste into a note: ![[$name]]"
