#!/usr/bin/env bash
# kb-stats - JSON for a waybar custom module: inbox items, words today, daily-note streak.
# shellcheck source=kb-common
source "$(dirname "$(readlink -f "$0")")/kb-common"

inbox=$(grep -c '^- \[ \]' "$INBOX" 2>/dev/null)
inbox=${inbox:-0}

today_file="$DAILY_DIR/$(date +%F).md"
words=0
[[ -f $today_file ]] && words=$(wc -w <"$today_file")

streak=0
while [[ -f $DAILY_DIR/$(date -d "-$streak day" +%F).md ]] && (( streak < 366 )); do
  streak=$((streak + 1))
done

notes=$(find "$VAULT" -name '*.md' -not -path '*/.*' | wc -l)

printf '{"text":"inbox %s · %sw · %sd","tooltip":"Inbox items: %s\\nWords in today'"'"'s note: %s\\nDaily-note streak: %s days\\nNotes in vault: %s\\n\\nClick: today   Right-click: review","class":"%s"}\n' \
  "$inbox" "$words" "$streak" "$inbox" "$words" "$streak" "$notes" \
  "$( (( inbox > 10 )) && echo busy || echo ok)"
