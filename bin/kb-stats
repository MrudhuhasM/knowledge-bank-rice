#!/usr/bin/env bash
# kb-stats - inbox items, words today, daily-note streak, note count.
#   kb-stats        JSON for the waybar module
#   kb-stats --raw  plain JSON numbers for the desktop widget
# shellcheck source=kb-common
source "$(dirname "$(readlink -f "$0")")/kb-common"

inbox=$(grep -c '^- \[ \]' "$INBOX" 2>/dev/null)
inbox=${inbox:-0}

today_file="$DAILY_DIR/$(date +%F).md"
words=0
[[ -f $today_file ]] && words=$(wc -w <"$today_file")

streak=0
while [[ -f $DAILY_DIR/$(date -d "-$streak day" +%F).md ]] && (( streak < 366 )); do
  streak=$((streak + 1))
done

notes=$(find "$VAULT" -name '*.md' -not -path "$VAULT/.*" -not -path "$VAULT/Templates/*" | wc -l)

# --raw: plain numbers for the desktop widget
if [[ ${1:-} == --raw ]]; then
  printf '{"inbox":%d,"words":%d,"streak":%d,"notes":%d}\n' "$inbox" "$words" "$streak" "$notes"
  exit 0
fi

printf '{"text":"  %s · %sw · %sd","tooltip":"Inbox items: %s\\nWords in today'"'"'s note: %s\\nDaily-note streak: %s days\\nNotes in vault: %s\\n\\nClick: today   Right-click: review","class":"%s"}\n' \
  "$inbox" "$words" "$streak" "$inbox" "$words" "$streak" "$notes" \
  "$( (( inbox > 10 )) && echo busy || echo ok)"
