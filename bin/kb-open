#!/usr/bin/env bash
# kb-open - open part of the vault in kv (Neovim).
#   kb-open inbox   the Inbox
#   kb-open home    Home.md (the vault's index page)
#   kb-open         the vault (lands on today's note)
# shellcheck source=kb-common
source "$(dirname "$(readlink -f "$0")")/kb-common"

case ${1:-} in
  inbox) kb_term kb-open "$KV" "$INBOX" ;;
  home)  kb_term kb-open "$KV" "$VAULT/Home.md" ;;
  *)     kb_term kb-open "$KV" ;;
esac
