#!/usr/bin/env bash
# kb-search - full-text search across the vault (file names + contents), opens the hit at its line.
# shellcheck source=kb-common
source "$(dirname "$(readlink -f "$0")")/kb-common"

if [[ ${1:-} != --tui ]]; then
  kb_term --float kb-search "$(kb_self)" --tui
  exit 0
fi

cd "$VAULT" || exit 1
preview='bat --style=plain --color=always --highlight-line {2} {1} 2>/dev/null || cat {1}'

sel=$(rg --line-number --no-heading --color=always --smart-case --type md '.' |
  fzf --ansi --delimiter : --nth 1,3.. \
      --prompt 'search > ' --header 'Enter: open   Esc: close' \
      --preview "$preview" --preview-window 'right,55%,+{2}-/2') || exit 0

file=${sel%%:*}
rest=${sel#*:}
line=${rest%%:*}
exec "$KV" "+$line" "$file"
