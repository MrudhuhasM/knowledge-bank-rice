#!/usr/bin/env bash
# Shared helpers for the kb-* scripts. Sourced, not run directly.

KB_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/kb/config"
# shellcheck source=/dev/null
[[ -f $KB_CONFIG ]] && source "$KB_CONFIG"

VAULT="${KB_VAULT:-${VAULT:-$HOME/vault}}"
export KB_VAULT="$VAULT"
INBOX="$VAULT/Inbox.md"
DAILY_DIR="$VAULT/Daily"
NOTES_DIR="$VAULT/Notes"
SOURCES_DIR="$VAULT/Sources"
TEMPLATES_DIR="$VAULT/Templates"
KB_BIN="$HOME/.local/bin"
KV="$KB_BIN/kv"

kb_notify() {
  command -v notify-send >/dev/null && notify-send -a "Knowledge Bank" "$@"
  return 0
}

kb_die() {
  kb_notify -u critical "Knowledge Bank" "$1"
  echo "kb: $1" >&2
  exit 1
}

[[ -d $VAULT ]] || kb_die "Vault not found: $VAULT"

# kb_menu PROMPT [LINES]  - options on stdin (or </dev/null with LINES=0 for free text), prints choice
kb_menu() {
  local prompt=$1 lines=${2:-8}
  if command -v rofi >/dev/null; then
    rofi -dmenu -i -p "$prompt" -l "$lines"
  elif command -v fuzzel >/dev/null; then
    fuzzel --dmenu --prompt "$prompt > "
  elif command -v wofi >/dev/null; then
    wofi --dmenu --prompt "$prompt"
  else
    kb_die "No menu program found (install rofi, fuzzel or wofi)"
  fi
}

# kb_term [--float] CLASS CMD...  - open CMD in a terminal window.
# --float gives the window class "kb.float", which hyprland.lua floats and centres.
kb_term() {
  local class
  if [[ $1 == --float ]]; then class=kb.float; shift 2; else class=$1; shift; fi
  local term="${KB_TERMINAL:-}" t
  if [[ -z $term ]]; then
    for t in kitty ghostty alacritty foot wezterm; do
      if command -v "$t" >/dev/null; then term=$t; break; fi
    done
  fi
  local -a cmd
  case $term in
    kitty)     cmd=(kitty --class "$class" -e "$@") ;;
    ghostty)   cmd=(ghostty "--class=$class" -e "$@") ;;
    alacritty) cmd=(alacritty --class "$class" -e "$@") ;;
    foot)      cmd=(foot --app-id "$class" "$@") ;;
    wezterm)   cmd=(wezterm start --class "$class" -- "$@") ;;
    *)         kb_die "No supported terminal (kitty, ghostty, alacritty, foot, wezterm). Set KB_TERMINAL." ;;
  esac
  setsid -f "${cmd[@]}" >/dev/null 2>&1
}

# kb_render_template TEMPLATE TITLE  - fill {{title}} {{date}} {{time}}
kb_render_template() {
  local content
  content=$(<"$1")
  content=${content//'{{title}}'/"$2"}
  content=${content//'{{date}}'/"$(date +%F)"}
  content=${content//'{{time}}'/"$(date +%H:%M)"}
  printf '%s\n' "$content"
}

# kb_obsidian_open PATH-IN-VAULT (without .md)
kb_obsidian_open() {
  local vault_name file
  vault_name=$(jq -rn --arg s "$(basename "$VAULT")" '$s|@uri')
  file=$(jq -rn --arg s "$1" '$s|@uri')
  setsid -f xdg-open "obsidian://open?vault=$vault_name&file=$file" >/dev/null 2>&1
}

kb_self() { readlink -f "$0"; }
