#!/usr/bin/env bash
# kb-review - a review session. Lists notes tagged #review (or `tags: [review]`)
# plus up to 10 random notes you haven't touched in 30+ days. Pick one, read/edit,
# close it, and you're back at the list. Remove the review tag when you're done with a note.
# shellcheck source=kb-common
source "$(dirname "$(readlink -f "$0")")/kb-common"

if [[ ${1:-} != --tui ]]; then
  kb_term --float kb-review "$(kb_self)" --tui
  exit 0
fi

cd "$VAULT" || exit 1

candidates() {
  rg -l --type md '(#review\b)|(^tags:.*\breview\b)' 2>/dev/null | sed 's/^/tagged\t/'
  find Notes Sources -name '*.md' -mtime +30 2>/dev/null | shuf -n 10 | sed 's/^/stale\t/'
}

preview='bat --style=plain --color=always {2} 2>/dev/null || cat {2}'

while :; do
  list=$(candidates | awk -F'\t' '!seen[$2]++')
  if [[ -z $list ]]; then
    echo "Nothing to review. Tag notes with #review to queue them."
    read -rn1 -p "Press any key to close."
    exit 0
  fi
  count=$(printf '%s\n' "$list" | wc -l)
  sel=$(printf '%s\n' "$list" |
    fzf --delimiter '\t' --prompt 'review > ' \
        --header "$count to review   Enter: open   Esc: finish" \
        --preview "$preview" --preview-window 'right,60%') || exit 0
  "$KV" "${sel#*$'\t'}"
done
