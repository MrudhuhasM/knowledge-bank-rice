#!/usr/bin/env bash
# kb-new - create a note from a template and open it.
#   kb-new           a normal note in Notes/
#   kb-new --source  a book / article / paper / video in Sources/
# shellcheck source=kb-common
source "$(dirname "$(readlink -f "$0")")/kb-common"

dir=$NOTES_DIR template=note prompt="New note"
if [[ ${1:-} == --source ]]; then
  dir=$SOURCES_DIR template=source prompt="New source"
fi

title=$(kb_menu "$prompt" 0 </dev/null) || exit 0
# Characters Obsidian can't use in file names
title=$(printf '%s' "$title" | tr -d '/\\:*?"<>|' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
[[ -z $title ]] && exit 0

mkdir -p "$dir"
file="$dir/$title.md"
if [[ ! -f $file ]]; then
  if [[ -f $TEMPLATES_DIR/$template.md ]]; then
    kb_render_template "$TEMPLATES_DIR/$template.md" "$title" >"$file"
  else
    printf '# %s\n\n' "$title" >"$file"
  fi
fi

kb_term kb-new "$KV" "$file"
